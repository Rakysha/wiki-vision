# ==============================================================================
# WikiVision v1.0-beta — Environment Configuration Example
# Copy this file to `config.env` or configure keys via the web UI settings.
# None of these keys are transmitted to any middleman server; all AI calls
# are made directly from your browser client to the respective provider API.
# ==============================================================================

# Preferred AI Provider: groq | bothub | deepseek | openai | gemini | openrouter | claude
AI_PROVIDER=groq

# Groq Cloud API (Recommended: Ultra-fast & Free tier available)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# BotHub API (Recommended for RU/CIS: Works without VPN, local card payments)
# Get key: https://bothub.chat
BOTHUB_API_KEY=
BOTHUB_MODEL=gpt-4o

# DeepSeek Official API (High intelligence, ultra-low cost)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI Official API (GPT-4o / GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (Aggregator with 200+ models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini API
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude API
# Get key: https://console.anthropic.com/
CLAUDE_API_KEY=
