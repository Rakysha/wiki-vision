# ==============================================================================
# WikiVision — .gitignore
# Prevents sensitive credentials, environment files, and build artifacts from leaking
# ==============================================================================

# Credentials, Keys & Secrets (STRICT: NEVER COMMIT)
config.env
*.env
*.env.local
*.env.*.local
web-reader/config.local.json

# Keep template config files tracked
!web-reader/config.json
!web-reader/config.example.json
!.env.example

# IDE & Editor Configurations
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI Assistant & IDE Agent Workspaces
.agents/
.gemini/

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Server Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Operating System Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Temporary Data
*.log
*.tmp
*.bak
*.swp
